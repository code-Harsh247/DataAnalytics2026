{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "webapp/backend/.venv/Scripts/uvicorn.exe",
      "runtimeArgs": ["app.main:app", "--reload", "--app-dir", "webapp/backend", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "webapp/frontend"],
      "port": 3000
    }
  ]
}
